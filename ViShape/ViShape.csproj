<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ViShape</AssemblyName>
    <RootNamespace>ViShape</RootNamespace>
    <Version>1.0.0</Version>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'' == ''">
    <AmongUsPath>C:\Program Files (x86)\Steam\steamapps\common\Among Us</AmongUsPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
    <PackageReference Include="Reactor" Version="2.*" />
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="*" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyToGame" AfterTargets="Build" Condition="Exists('\BepInEx\plugins')">
    <Copy SourceFiles=".dll" DestinationFolder="\BepInEx\plugins\" />
  </Target>
</Project>
